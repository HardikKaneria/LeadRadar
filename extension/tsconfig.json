{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "rootDir": ".",
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "types": []
  },
  "include": ["src/**/*.ts", "scripts/**/*.mjs"],
  "exclude": ["src/**/*.spec.ts"]
}
