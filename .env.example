# ─────────────────────────────────────────────────────────────
# Radar OIP — environment template. Copy to .env and fill in.
# NEVER commit .env. Secrets stay out of git.
# ⚠️ The old Supabase project's keys are in git history — ROTATE them before use.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# API
API_PORT=4000
API_URL=http://localhost:4000
# CORS allow-list for the web app. Comma-separate to allow multiple origins.
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Redis (BullMQ)
AI_ORG_REQUEST_RATE_LIMIT_RPM=60
AI_PROVIDER_RATE_LIMIT_COOLDOWN_SECONDS=90

# ── Supabase (identity + database + RLS) ──
# From Supabase dashboard → Settings → API. Rotate keys first.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-rotated-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-rotated-service-role-key   # server-side ONLY (api + worker)
DISCOVERY_IMPORTS_BUCKET=discovery-imports                # create this private Storage bucket for CSV imports

# Web (Vite) — public, anon key only. Never put the service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-rotated-anon-key
VITE_API_URL=http://localhost:4000

# Optional before P3-12; required once you store pooled AI provider keys in Supabase
# ENCRYPTION_KEY=change-me-32-byte-base64

# AI providers (Phase 3 — leave blank for now)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
