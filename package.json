{
  "name": "radar-oip",
  "version": "0.1.0",
  "private": true,
  "description": "Radar OIP — AI-powered Opportunity Intelligence Platform (not a CRM).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @radar/api start:dev",
    "dev:web": "pnpm --filter @radar/web dev",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --linked > packages/supabase/src/database.types.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  },
  "pnpm": {
    "overrides": {
      "@supabase/supabase-js": "2.45.4"
    }
  }
}
